# Copy the values below into restaurant-pos/.env.local for a restaurant PC.
NEXT_PUBLIC_ANAIRA_LOCAL_PRIMARY=true
ANAIRA_LOCAL_PRIMARY=true
NEXT_PUBLIC_LOCAL_SUPABASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_LOCAL_SUPABASE_ANON_KEY=YOUR_LOCAL_ANON_KEY
SUPABASE_LOCAL_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY
ANAIRA_LOCAL_SERVER_ENABLED=true
LOCAL_DATABASE_URL=postgresql://supabase_admin@127.0.0.1:54322/postgres
LOCAL_DB_CONTAINER=supabase-db
LOCAL_DB_USER=supabase_admin
LOCAL_DB_NAME=postgres
ANAIRA_RESTAURANT_ID=YOUR_RESTAURANT_UUID
ANAIRA_SYNC_NODE=restaurant-local-server
ANAIRA_SYNC_INTERVAL_MS=5000
SUPABASE_CLOUD_DB_URL=YOUR_CLOUD_POSTGRES_CONNECTION_STRING
# Optional: existing Docker Compose stack directory. Leave blank if the stack is already running.
LOCAL_SUPABASE_STACK_DIR=
