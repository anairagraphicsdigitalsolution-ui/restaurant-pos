# Anaira Meta Marketing OAuth / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
# Optional; if omitted Anaira derives this from the incoming request origin.
META_REDIRECT_URI=https://YOUR-ANAIRA-DOMAIN/api/marketing/meta/oauth/callback
META_GRAPH_VERSION=v24.0
# Optional comma-separated OAuth scopes; keep aligned with the Meta products enabled in your app.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,instagram_manage_insights,business_management
MARKETING_TOKEN_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Public website enquiry email (server-side only; never expose these in NEXT_PUBLIC_* variables)
GMAIL_USER=anairagraphicsdigitalsolution@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
MARKETING_LEAD_TO=anairagraphicsdigitalsolution@gmail.com
