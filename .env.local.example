NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SERVICE_ROLE_KEY

SUPABASE_CLOUD_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_CLOUD_DB_SSL=true

ANAIRA_LOCAL_SERVER_ENABLED=true
LOCAL_DATABASE_URL=postgresql://supabase_admin:PASSWORD@127.0.0.1:54322/postgres
LOCAL_DB_CONTAINER=supabase-db
LOCAL_DB_USER=supabase_admin
LOCAL_DB_NAME=postgres

ANAIRA_RESTAURANT_ID=YOUR-RESTAURANT-UUID
ANAIRA_SYNC_NODE=restaurant-local-server
ANAIRA_LOCAL_PRIMARY=true
NEXT_PUBLIC_ANAIRA_LOCAL_PRIMARY=true
ANAIRA_SYNC_INTERVAL_MS=5000
ANAIRA_SYNC_BATCH_SIZE=100
